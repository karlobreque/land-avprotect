---
const highlights = [
  "Monitoreo 24/7",
  "Personal certificado OS10",
  "Respuesta ante emergencias",
];
---

<section id="inicio" class="relative overflow-hidden pt-16">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-32 left-1/4 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
    <div class="absolute top-40 right-0 h-80 w-80 rounded-full bg-sky-600/10 blur-3xl"></div>
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-24">
    <div class="max-w-xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Seguridad privada profesional
      </span>

      <h1 class="mt-5 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Protege lo que más
        <span class="text-accent">te importa</span>
      </h1>

      <p class="mt-5 text-base leading-relaxed text-slate-400 sm:text-lg">
        Instalación y monitoreo de cámaras CCTV y guardias de seguridad certificados OS10
        para tiendas de retail, bodegas y almacenes. Vigilancia inteligente, respuesta
        inmediata y total tranquilidad.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#contacto"
          class="inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-navy-950 transition hover:bg-accent-strong"
        >
          Solicitar cotización
        </a>
        <a
          href="#servicios"
          class="inline-flex items-center justify-center rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
        >
          Conocer servicios
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
        {highlights.map((item) => (
          <li class="flex items-center gap-2 text-sm text-slate-300">
            <svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="relative lg:justify-self-end">
      <div class="relative mx-auto w-full max-w-md rounded-2xl border border-white/10 bg-navy-900/70 p-5 shadow-2xl shadow-black/40 backdrop-blur">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-emerald-400"></span>
            <span class="text-xs font-medium uppercase tracking-wider text-slate-400">En vivo</span>
          </div>
          <span class="rounded-md bg-white/5 px-2 py-1 text-[11px] font-medium text-slate-400">CCTV · 04</span>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          {[1, 2, 3, 4].map((cam) => (
            <div class="relative aspect-video overflow-hidden rounded-lg border border-white/10 bg-gradient-to-br from-navy-800 to-navy-700">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(56,189,248,0.25),transparent_60%)]"></div>
              <span class="absolute bottom-1.5 left-2 text-[10px] font-medium text-slate-400">CAM 0{cam}</span>
            </div>
          ))}
        </div>

        <div class="mt-4 flex items-center justify-between rounded-lg border border-emerald-400/20 bg-emerald-400/5 px-3 py-2.5">
          <span class="text-xs text-slate-300">Estado del sistema</span>
          <span class="flex items-center gap-1.5 text-xs font-semibold text-emerald-400">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            Operativo
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
