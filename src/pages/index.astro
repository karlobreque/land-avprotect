---
import Layout from "../layouts/base.astro";
import Navbar from "../components/Navbar.astro";
import HeroSection from "../components/HeroSection.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Footer from "../components/Footer.astro";

const services = [
  {
    icon: "camera" as const,
    title: "CCTV y monitoreo 24/7",
    description:
      "Instalación profesional de cámaras de seguridad y monitoreo remoto permanente desde nuestra central, con alertas en tiempo real.",
    features: [
      "Cámaras HD/4K con visión nocturna",
      "Monitoreo remoto 24/7",
      "Alertas y notificaciones en tiempo real",
      "Mantenimiento y soporte técnico",
    ],
  },
  {
    icon: "shield" as const,
    badge: "OS10",
    title: "Guardias de seguridad",
    description:
      "Personal certificado OS10 especializado en tiendas de retail, bodegas y almacenes, con protocolos de control de acceso y prevención.",
    features: [
      "Agentes certificados con OS10",
      "Control de accesos y rondas",
      "Prevención de pérdidas (retail)",
      "Supervisión y reportes operativos",
    ],
  },
];

const stats = [
  { value: "+10", label: "Años de experiencia" },
  { value: "24/7", label: "Monitoreo continuo" },
  { value: "100%", label: "Personal certificado" },
  { value: "+500", label: "Sedes protegidas" },
];

const values = [
  {
    title: "Respuesta inmediata",
    text: "Central de monitoreo conectada con protocolos de acción ante cualquier incidente.",
  },
  {
    title: "Tecnología confiable",
    text: "Equipamiento CCTV de última generación y sistemas redundantes de vigilancia.",
  },
  {
    title: "Personal capacitado",
    text: "Guardias certificados OS10 con formación continua y supervisión permanente.",
  },
];
---

<Layout>
  <Navbar />
  <main>
    <HeroSection />

    <section id="servicios" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold uppercase tracking-wider text-accent">Servicios</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Seguridad integral para tu negocio
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate-400">
          Combinamos vigilancia tecnológica y personal especializado para cubrir las
          necesidades de retail, bodegas y almacenes.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {services.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>
    </section>

    <section id="nosotros" class="border-y border-white/5 bg-navy-900/40">
      <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <span class="text-sm font-semibold uppercase tracking-wider text-accent">Nosotros</span>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Confianza que se respalda con resultados
            </h2>
            <p class="mt-4 text-base leading-relaxed text-slate-400">
              Somos una empresa de seguridad privada enfocada en proteger activos, personas
              y operaciones. Cada cliente recibe un plan a medida con procesos claros y
              reportes transparentes.
            </p>

            <dl class="mt-8 grid grid-cols-2 gap-6">
              {stats.map((stat) => (
                <div>
                  <dt class="text-2xl font-bold text-white sm:text-3xl">{stat.value}</dt>
                  <dd class="mt-1 text-sm text-slate-400">{stat.label}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="space-y-4">
            {values.map((value) => (
              <div class="flex gap-4 rounded-xl border border-white/10 bg-navy-950/60 p-5">
                <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-accent/10 text-accent">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <div>
                  <h3 class="font-semibold text-white">{value.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-slate-400">{value.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-navy-800 to-navy-900 px-6 py-14 text-center sm:px-12">
        <div class="pointer-events-none absolute -top-24 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-accent/20 blur-3xl" aria-hidden="true"></div>

        <div class="relative mx-auto max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Solicita una evaluación sin costo
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-300">
            Cuéntanos sobre tu tienda, bodega o almacén y diseñamos un plan de seguridad
            a la medida de tu operación.
          </p>

          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href="https://wa.me/51000000000"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-navy-950 transition hover:bg-accent-strong"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 00-8.7 15L2 22l5.2-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 01-1.9-1.2 7.1 7.1 0 01-1.3-1.7c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.3-.5l.2-.4-.1-.4-.7-1.6c-.2-.4-.4-.4-.5-.4h-.4a.9.9 0 00-.6.3 2.7 2.7 0 00-.8 2 4.7 4.7 0 001 2.5 10.7 10.7 0 004.1 3.6c.6.2 1 .4 1.3.5.6.2 1.1.2 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1z" />
              </svg>
              Escríbenos por WhatsApp
            </a>
            <a
              href="tel:+51000000000"
              class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
            >
              Llamar ahora
            </a>
          </div>

          <p class="mt-6 text-sm text-slate-400">
            Atención inmediata · Santiago, Chile · Disponible 24/7
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
